@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Dàn bố cục trang web</title>

    <style type="text/css">

        body {
            background-color: lightgoldenrodyellow;
            font-family: 'Times New Roman', serif;
        }

        .container {
            border: 5px solid black;
            width: 90%;
            background-color: burlywood;
            margin: 10px auto;
        }

        .banner {
            background-color: forestgreen;
            height: 100px;
        }

        .navigator {
            background-color: lawngreen;
            height: 40px;
        }

        .sidebar {
            background-color: lightgreen;
            min-height: 455px;
            display: block;
            text-align: left;
            float: left;
            width: 20%;
        }

        .content {
            background-color: powderblue;
            width: 80%;
            min-height: 450px;
            float: left;
            padding-top: 5px;
            /* margin-left: 20%; */
        }

        .footer {
            background-color: cadetblue;
        }
    </style>
</head>

<body>

    <div class="container">

        <div class="banner">
            BANNER
        </div>

        <div class="navigator">
            NAVIGATOR
        </div>

        <div class="sidebar">
            SIDEBAR
        </div>

        <div class="content">
            CONTENT
        </div>

        <div class="footer">
            FOOTER
        </div>

    </div>

</body>
</html>