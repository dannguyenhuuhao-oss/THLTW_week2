@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Định dạng bảng</title>

    <style type="text/css">
        table {
            border-top: 3px solid black;
            border-bottom: 3px solid black;
            border-collapse: collapse;
            width: 400px;
            height: 300px;
        }

        th {
            background-color: paleturquoise;
            font-size: 20px;
            color: maroon;
            border: 1px solid black;
        }

        td {
            text-align: center;
            border: 1px solid black;
        }

        .tr_le {
            background-color: lightpink;
        }

        .tr_chan {
            background-color: lightgreen;
        }

        .cot1 {
            background-color: lightgoldenrodyellow;
        }
    </style>
</head>

<body>

    <table>
        <tr>
            <th class="cot1">column 1</th>
            <th>column 2</th>
            <th>column 3</th>
        </tr>

        <tr class="tr_le">
            <td class="cot1">column 1</td>
            <td>column 2</td>
            <td>column 3</td>
        </tr>

        <tr class="tr_chan">
            <td class="cot1">column 1</td>
            <td>column 2</td>
            <td>column 3</td>
        </tr>

        <tr class="tr_le">
            <td class="cot1">column 1</td>
            <td>column 2</td>
            <td>column 3</td>
        </tr>
    </table>

</body>
</html>