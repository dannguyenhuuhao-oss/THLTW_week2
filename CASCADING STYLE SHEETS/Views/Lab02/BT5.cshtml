                    <div class="photo-placeholder">photo</div>
                    <br>
                    <span class="cc-badge">CREATIVE COMMONS</span><br>
                    This work is licensed under a <a href="#">Creative Commons License</a>.
                </div>
                <div class="three-right">
                    <div class="box">There is nothing in this world constant but inconstancy.</div>
                </div>
            </div>
            <div class="three-footer">Designed by <a href="#">Ben Meadowcroft</a></div>
        </div>
    </div>

</body>
</html>