@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Tạo thanh Navigator</title>

    <style type="text/css">
        #menu a:link, #menu a:visited{
            position: relative;
            display: block;
            text-align: center;
            color: white;
            text-decoration: none;
            padding: 5px;
            margin: 10px;
            background-color: lightslategray;
            width: 100px;
            border:3px solid black;
            border-color:lightgreen lightpink lavender seagreen;
        }

        #menu a:link{
            color: white;
        }

        #menu a:visited{
            color:darkgreen;
        }

        #menu a:hover{
            color:red;
            top: 5px;
            left:5px;
            background-color:gold;
        }

    </style>
</head>

<body>
    <div id="menu">
        <a href="#">Home</a>
        <a href="#">About</a>
        <a href="#">History</a>
        <a href="#">Team</a>
        <a href="#">Offices</a>
    </div>
</body>
</html>