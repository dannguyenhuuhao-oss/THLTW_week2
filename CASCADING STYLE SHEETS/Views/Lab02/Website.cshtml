<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>Porto eCommerce</title>
    <style>
  :root{
    --ink:#222; --muted:#777; --line:#eee; --accent:#2b2b2b;
    padding-top: env(safe-area-inset-top,0px);
    padding-bottom: env(safe-area-inset-bottom,0px);
  }
  *{box-sizing:border-box;}
  body{margin:0;font-family:Arial,Helvetica,sans-serif;color:var(--ink);background:#fff;}

  /* ---- top nav ---- */
  .navbar{display:flex;align-items:center;justify-content:space-between;padding:14px 30px;border-bottom:1px solid var(--line);flex-wrap:wrap;gap:10px;}
  .logo{font-size:22px;font-weight:800;letter-spacing:-.5px;}
  .logo span{display:block;font-size:9px;font-weight:400;letter-spacing:1px;color:var(--muted);}
  .menu{display:flex;gap:22px;font-size:12px;font-weight:600;letter-spacing:.3px;list-style:none;margin:0;padding:0;}
  .menu li{position:relative;cursor:pointer;}
  .menu .badge{background:#3ecf8e;color:#fff;font-size:8px;padding:1px 5px;border-radius:8px;position:absolute;top:-10px;right:-18px;}
  .nav-right{display:flex;align-items:center;gap:16px;font-size:11px;color:var(--muted);}
  .nav-right select{border:none;background:none;font-size:11px;color:var(--muted);}
  .cart-pill{background:#f4f4f4;border-radius:14px;padding:5px 12px;font-size:11px;}

  /* ---- hero ---- */
  .hero{position:relative;height:360px;overflow:hidden;background:
    radial-gradient(circle at 78% 40%, #d8a98a 0%, #8a5a45 35%, #2a2320 70%);
  }
  .hero-text{position:absolute;left:40px;top:60px;color:#fff;max-width:320px;}
  .hero-text .tag{font-size:12px;letter-spacing:2px;color:#e0c4b0;margin-bottom:6px;}
  .hero-text h1{font-size:38px;margin:0 0 8px;font-weight:800;}
  .hero-text .sub{font-size:14px;color:#ddd;margin-bottom:16px;}
  .shop-btn{display:inline-block;border-bottom:2px solid #fff;padding-bottom:3px;font-size:12px;font-weight:700;letter-spacing:1px;}
  .hero-face{position:absolute;right:0;top:0;bottom:0;width:55%;
    background:
      radial-gradient(ellipse at 35% 30%, #c9906f 0%, #a5674a 45%, transparent 70%),
      linear-gradient(200deg,#3a1f18,#1a1210 80%);
  }
  .hero-face::after{
    content:"👓"; position:absolute; left:38%; top:22%; font-size:70px; filter:drop-shadow(0 4px 6px rgba(0,0,0,.4));
  }

  /* ---- category strip ---- */
  .categories{display:flex;gap:16px;padding:24px 30px;flex-wrap:wrap;}
  .cat-card{flex:1;min-width:200px;position:relative;height:170px;border-radius:2px;overflow:hidden;}
  .cat-card .art{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:54px;}
  .cat-1 .art{background:linear-gradient(135deg,#efefef,#dcdcdc);}
  .cat-2 .art{background:linear-gradient(135deg,#3a3a3a,#1a1a1a);}
  .cat-3 .art{background:linear-gradient(135deg,#2c3e5e,#1c2740);}
  .cat-label{position:absolute;left:14px;bottom:14px;background:#2b2f3a;color:#fff;font-size:11px;letter-spacing:1px;font-weight:700;padding:8px 14px;}

  /* ---- section title ---- */
  .section-title{text-align:center;font-size:13px;letter-spacing:2px;font-weight:700;color:#333;margin:34px 0 20px;text-transform:uppercase;}

  /* ---- product grid ---- */
  .products{display:flex;gap:16px;padding:0 30px 30px;flex-wrap:wrap;}
  .product{flex:1;min-width:150px;text-align:center;}
  .product .thumb{height:190px;border-radius:2px;margin-bottom:10px;position:relative;overflow:hidden;}
  .product .thumb .fig{position:absolute;inset:0;}
  .p1 .fig{background:linear-gradient(160deg,#e7cbb0,#3a2a22 75%);}
  .p2 .fig{background:linear-gradient(160deg,#d8c9c2,#241a1a 75%);}
  .p3 .fig{background:linear-gradient(160deg,#e9dcc9,#4a3222 75%);}
  .p4 .fig{background:linear-gradient(160deg,#dcb9a8,#2e1f1a 75%);}
  .p5 .fig{background:linear-gradient(160deg,#f0e3d3,#5a3d2e 75%);}
  .product .name{font-size:12.5px;font-weight:600;margin-bottom:4px;}
  .stars{color:#f0b400;font-size:11px;letter-spacing:2px;margin-bottom:2px;}
  .price{font-size:13px;font-weight:700;}

  /* ---- promo band ---- */
  .promo{position:relative;height:220px;background:
    radial-gradient(circle at 80% 30%, #6a4a3a 0%, #201512 60%);
    display:flex;align-items:center;justify-content:center;flex-direction:column;color:#fff;text-align:center;}
  .promo h2{font-size:30px;margin:0;font-weight:800;letter-spacing:1px;}
  .promo h2 b{font-weight:900;}
  .promo p{font-size:13px;color:#e8d9d0;margin-top:6px;}

 
    </style>
</head>
<body>

    <div class="navbar">
        <div class="logo">porto<span>eCommerce</span></div>
        <ul class="menu">
            <li>HOME</li>
            <li>FASHION <span class="badge">NEW</span></li>
            <li>ELECTRONICS</li>
            <li>MOTORS</li>
        </ul>
        <div class="nav-right">
            <span>MY ACCOUNT</span>
            <span>DASHBOARD</span>
            <span>MY WISHLIST</span>
            <span>BLOG</span>
            <span>LOG IN</span>
            <select><option>USD</option></select>
            <select><option>ENGLISH</option></select>
            <span class="cart-pill">🛍 0 item(s)</span>
        </div>
    </div>

    <div class="hero">
        <div class="hero-face"></div>
        <div class="hero-text">
            <div class="tag">EXCLUSIVE</div>
            <h1>Sunglasses</h1>
            <div class="sub">Incredible prices</div>
            <div class="shop-btn">SHOP NOW</div>
        </div>
    </div>

    <div class="categories">
        <div class="cat-card cat-1"><div class="art">🕶️</div><div class="cat-label">SUNGLASSES</div></div>
        <div class="cat-card cat-2"><div class="art">👗</div><div class="cat-label">WOMAN DRESSES</div></div>
        <div class="cat-card cat-3"><div class="art">👜</div><div class="cat-label">WOMAN BAGS</div></div>
    </div>

    <div class="section-title">Weekly Featured Products</div>
    <div class="products">
        <div class="product p1"><div class="thumb"><div class="fig"></div></div><div class="name">Women Fashion-Blue</div><div class="stars">★★★★★</div><div class="price">$80.00</div></div>
        <div class="product p2"><div class="thumb"><div class="fig"></div></div><div class="name">Women Fashion</div><div class="stars">★★★★★</div><div class="price">$80.00</div></div>
        <div class="product p3"><div class="thumb"><div class="fig"></div></div><div class="name">Women Fashion-White</div><div class="stars">★★★★★</div><div class="price">$80.00</div></div>
        <div class="product p4"><div class="thumb"><div class="fig"></div></div><div class="name">Women Fashion-Black</div><div class="stars">★★★★★</div><div class="price">$80.00</div></div>
        <div class="product p5"><div class="thumb"><div class="fig"></div></div><div class="name">Women Fashion-Yellow</div><div class="stars">★★★★★</div><div class="price">$80.00</div></div>
    </div>

    <div class="promo">
        <h2>SPECIAL <b>PROMO</b></h2>
        <p>Up to 70% off — shop the collection</p>
    </div>

</body>
</html>